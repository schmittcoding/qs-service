          {"name": "category", "in": "query", "required": false, "schema": {"$ref": "#/components/schemas/TransactionType"}, "description": "RechargeType filter."}
        ],
        "responses": {
          "200": {
            "description": "One page of packages.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminRechargeInfoPage"}}}
          },
          "400": {"$ref": "#/components/responses/PaymentsBadQuery"},
          "401": {"$ref": "#/components/responses/AdminUnauthorized"},
          "500": {"$ref": "#/components/responses/AdminUnexpected"}
