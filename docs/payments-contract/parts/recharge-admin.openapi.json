          }}
        },
        "responses": {
          "200": {
            "description": "Updated gateway.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GatewayInfo"}}}
          },
          "400": {"$ref": "#/components/responses/AdminBadJson"},
          "401": {"$ref": "#/components/responses/AdminUnauthorized"},
          "404": {"description": "Path is not a UUID (actix plain text).", "content": {"text/plain": {"schema": {"type": "string"}}}},
          "500": {
            "description": "Gateway not found or database failure (message text says 'recharge info').",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RechargeAdminError"}, "example": {"error": "Failed to fetch recharge info"}}}
          }
        }
      }
    },
