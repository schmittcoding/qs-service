{
  "paths": {
    "/admin/v1/recharge": {
      "get": {
        "tags": ["Recharge administration"],
        "operationId": "adminListTransactions",
        "summary": "Search and page all transactions (multi-value filters)",
        "description": "Primary admin transaction list. Query is parsed with serde_qs (max depth 5, non-strict, so percent-encoded brackets are accepted). Multi-value filters use bracket notation: `?status[]=0&status[]=1&method[]=1&method[]=4` (indexed `status[0]=0` also works). Empty arrays mean no filter. Calls sp_GetWebTransactions: `search` matches UserName LIKE '%search%' OR RefferenceCode = search; rows sort Pending first, then TransactionTime DESC.\n\nPAGINATION QUIRK: the procedure computes OFFSET = page × limit, so it is effectively 0-based. page=1 (the default) skips the first `limit` rows; send page=0 for the first page. page/limit are cast from usize to i16 (truncating); limit is not clamped. Response has no total_pages.",
        "x-source": ["ran-access-point/src/routes/admin/recharge/mod.rs#L158", "ran-db-core/src/webmanager/transaction/mod.rs#L230", "db-scripts/webdb/Procedures/Administration/sp_GetWebTransactions.sql"],
        "security": [{"AdminBearerJWT": []}],
        "parameters": [
          {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0, "maximum": 32767, "default": 1, "x-rust-type": "Option<usize>"}, "description": "SQL page index; OFFSET = page × limit (see quirk)."},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 32767, "default": 10, "x-rust-type": "Option<usize>"}, "description": "Page size. Not clamped."},
          {"name": "search", "in": "query", "required": false, "schema": {"type": "string", "x-rust-type": "Option<String>"}, "description": "UserName substring or exact reference code."},
          {"name": "method[]", "in": "query", "required": false, "style": "form", "explode": true, "schema": {"type": "array", "items": {"$ref": "#/components/schemas/TransactionType"}, "x-rust-type": "Option<Vec<i16>>"}, "description": "Transaction types to include (Rust field `method`)."},
          {"name": "status[]", "in": "query", "required": false, "style": "form", "explode": true, "schema": {"type": "array", "items": {"$ref": "#/components/schemas/TransactionStatus"}, "x-rust-type": "Option<Vec<i16>>"}, "description": "Transaction statuses to include (Rust field `status`)."}
        ],
        "responses": {
          "200": {
            "description": "One page of transactions.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminTransactionPage"}}}
          },
          "400": {
            "description": "serde_qs could not parse the query string.",
            "content": {"text/plain": {"schema": {"type": "string", "examples": ["Invalid query: ..."]}}}
          },
          "401": {"$ref": "#/components/responses/AdminUnauthorized"},
          "500": {"$ref": "#/components/responses/AdminUnexpected"}
        }
      }
    },
    "/admin/v1/recharge/recharge-logs": {
      "get": {
        "tags": ["Recharge administration"],
        "operationId": "adminListRechargeLogs",
        "summary": "Legacy transaction list (single-value filters)",
        "description": "Loads ALL WebTransaction rows (or all rows with the given status) ordered by TransactionTime DESC, then filters `category` and `search` and paginates in memory. `search` matches when user_name CONTAINS it (case-sensitive), or equals the transaction_id string, or equals reference_code. start_date/end_date are accepted but ignored. Every row's proof image is base64-encoded into the response. Prefer GET /admin/v1/recharge.",
        "x-source": ["ran-access-point/src/routes/admin/recharge/mod.rs#L64", "ran-db-core/src/webmanager/transaction/mod.rs#L164", "ran-db-core/src/webmanager/transaction/mod.rs#L197"],
        "security": [{"AdminBearerJWT": []}],
        "parameters": [
          {"$ref": "#/components/parameters/PaymentsPage"},
          {"$ref": "#/components/parameters/PaymentsLimit"},
          {"name": "status", "in": "query", "required": false, "schema": {"$ref": "#/components/schemas/TransactionStatus"}, "description": "Filtered in SQL."},
          {"name": "category", "in": "query", "required": false, "schema": {"$ref": "#/components/schemas/TransactionType"}, "description": "Transaction type; filtered in memory."},
          {"name": "search", "in": "query", "required": false, "schema": {"type": "string"}, "description": "See description."}
        ],
        "responses": {
          "200": {
            "description": "One page of transactions.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TransactionPage"}}}
          },
          "400": {"$ref": "#/components/responses/PaymentsBadQuery"},
          "401": {"$ref": "#/components/responses/AdminUnauthorized"},
          "500": {
            "description": "Database failure.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RechargeAdminError"}, "example": {"error": "Failed to fetch recharge logs"}}}
          }
        }
      }
    },
    "/admin/v1/recharge/update-transaction/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}, "example": "9f1c2d3e-4b5a-4c6d-8e7f-a0b1c2d3e4f5", "description": "WebTransaction.transaction_id. Non-UUID → actix plain-text 404."}],
      "put": {
        "tags": ["Recharge administration"],
        "operationId": "adminUpdateTransactionStatus",
        "summary": "Approve or decline a pending transaction",
        "description": "The new status is a QUERY parameter, not a body (any body is ignored). Only rows still Pending (0) are updated; anything else returns 500. Setting 1 fires trigger trg_AddWebPoints, which adds transaction_amount (points) to the buyer's WebUser.WebPoints. Any i16 is accepted (no range check); use 1 (approve) or 2 (decline). On success: the buyer's profile cache is invalidated and a Discord embed is posted to env DISCORD_TRANSACTION_WEBHOOK (skipped if unset). The approving administrator is not recorded (TODO in code) and admin_remarks is not written.",
        "x-source": ["ran-access-point/src/routes/admin/recharge/mod.rs#L202", "ran-db-core/src/webmanager/transaction/mod.rs#L91", "db-scripts/webdb/Triggers/trg_AddWebPoints.sql"],
        "security": [{"AdminBearerJWT": []}],
        "parameters": [
          {"name": "status", "in": "query", "required": true, "schema": {"$ref": "#/components/schemas/TransactionStatus"}, "example": 1, "description": "UpdateStatusParams.status (i16)."}
        ],
        "responses": {
          "200": {
            "description": "Status changed.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminMessage"}, "example": {"message": "Transaction updated successfully"}}}
          },
          "400": {"description": "status query missing or not an integer (actix plain text).", "content": {"text/plain": {"schema": {"type": "string"}}}},
          "401": {"$ref": "#/components/responses/AdminUnauthorized"},
          "404": {"description": "Path is not a UUID (actix plain text).", "content": {"text/plain": {"schema": {"type": "string"}}}},
          "500": {
            "description": "Transaction missing or no longer Pending (anyhow message passed through), or database failure.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RechargeAdminError"}, "example": {"error": "Transaction with id 9f1c2d3e-4b5a-4c6d-8e7f-a0b1c2d3e4f5 not found"}}}
          }
        }
      }
    },
    "/admin/v1/recharge/update-recharge-info/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}, "example": "7c9e6679-7425-40de-944b-e07fc1f90ae7", "description": "RechargeInfo.id. Non-UUID → actix plain-text 404."}],
      "put": {
        "tags": ["Recharge administration"],
        "operationId": "adminUpdateRechargeInfo",
        "summary": "Replace a recharge package",
        "description": "Full replacement of type, amount, points and status. `discount` is accepted but NOT written (absent from the UPDATE SET clause); the returned row shows the stored discount. Returns the updated row (OUTPUT inserted.*). The handler is registered twice in configure(); only the first registration is reachable.",
        "x-source": ["ran-access-point/src/routes/admin/recharge/mod.rs#L258", "ran-db-core/src/webmanager/transaction/mod.rs#L417"],
        "security": [{"AdminBearerJWT": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {
            "schema": {"$ref": "#/components/schemas/AddRechargeInfo"},
            "examples": {"update": {"summary": "Change price and points", "value": {"type": 2, "amount": 12.0, "discount": null, "points": 1200.0, "status": 1}}}
          }}
        },
        "responses": {
          "200": {
            "description": "Updated package.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RechargeInfo"}}}
          },
          "400": {"$ref": "#/components/responses/AdminBadJson"},
          "401": {"$ref": "#/components/responses/AdminUnauthorized"},
          "404": {"description": "Path is not a UUID (actix plain text).", "content": {"text/plain": {"schema": {"type": "string"}}}},
          "500": {
            "description": "Package not found or database failure.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RechargeAdminError"}, "example": {"error": "Failed to fetch recharge info"}}}
          }
        }
      }
    },
    "/admin/v1/recharge/update-gateway-info/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}, "example": "0d4f7b9a-2c1e-4f6b-9a3d-5e8c7b6a1f20", "description": "GatewayInfo.id. Non-UUID → actix plain-text 404."}],
      "put": {
        "tags": ["Recharge administration"],
        "operationId": "adminUpdateGatewayInfo",
        "summary": "Replace a payment gateway",
        "description": "Full replacement of every field including the image. `image` MUST be valid standard base64: invalid base64 panics inside the DB layer (`.unwrap()`), dropping the connection without an HTTP response. Returns the updated row.",
