    "/admin/v1/recharge/add-recharge-info": {
      "post": {
        "tags": ["Recharge administration"],
        "operationId": "adminCreateRechargeInfo",
        "summary": "Create a recharge package",
        "description": "Inserts a RechargeInfo row with inline SQL in the handler (RechargeID defaults to NEWSEQUENTIALID()). `discount` is written only when present and non-null. The new ID is not returned.",
